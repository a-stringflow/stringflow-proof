theorem basin_1e6_allodd_cert :
    forall m : Nat, 7 <= m -> m <= 1000000 -> odd m ->
      exists c : Cert, coverCert certAllOdd m = some c /\
        exists S : Nat, firstC3H c.w.length m = (true, S) /\ S <= 64 := by
  intro m hm7 hmle hod
  exact certsOKAllOdd_spec 64 7 1000001 certAllOdd certAllOdd_check
    m hm7 (Nat.lt_succ_of_le hmle) hod

