      exists c : Cert, coverCert cert617 m = some c /\
        exists S : Nat, firstC3H c.w.length m = (true, S) /\ S <= 26 := by
  exact certsOK_spec 26 7 617 cert617 cert617_check

theorem basin_1e6_cert :
    forall m : Nat, 7 <= m -> m <= 1000000 -> admissible m ->
      exists c : Cert, coverCert cert1e6 m = some c /\
        exists S : Nat, firstC3H c.w.length m = (true, S) /\ S <= 64 := by
  intro m hm7 hmle hadm
  exact certsOK_spec 64 7 1000001 cert1e6 cert1e6_check m hm7 (Nat.lt_succ_of_le hmle) hadm

