def subMod (a b m : Nat) : Nat := (a + m - b % m) % m

def wordBad (Q L S m0 mod target inv5 D cmin cmax : Nat) (up : Bool) (pos : List Nat) : Bool :=
  if ! up then true else
    let Au := auOfPos L pos
    let r := (subMod (target % mod) Au mod) * inv5 % mod
    if decide (7 <= r) && decide (r < m0) then
      if decide (5^Q * Au <= D * r) then
        let num := D * r - 5^Q * Au
        let den := 2^S
        if decide (num % den = 0) then
          let Areq := num / den
          decide (Areq < cmin) || decide (Areq > cmax)
        else true
      else true
    else true

def chainAVals (b Q : Nat) : List Nat :=
  if b = 1 then
    (combinations (Q - 1) 1).map (fun pos =>
      auOf ([3] ++ (List.range (Q - 1)).map (fun i => if pos.contains i then 4 else 3)))
  else
    [auOf ([5] ++ (List.range (Q - 1)).map (fun _ => 3))]

def listMin : List Nat -> Nat
  | [] => 0
  | x :: xs => xs.foldl (fun a b => min a b) x

def listMax : List Nat -> Nat
  | [] => 0
  | x :: xs => xs.foldl (fun a b => max a b) x

def tripleScan (b Q L : Nat) : Bool :=
  let U := tableU b Q L
  let S := tableS b Q L
  let m0 := tableM0 b Q L
  let mod := tableMod b Q L
  let target := tableTarget b Q L
  let inv5 := tableInv5 b Q L
  let D := tableD b Q L
  let cvals := chainAVals b Q
  let cmin := listMin cvals
  let cmax := listMax cvals
  let up := tableUpper b Q L
  let posCount := if b = 1 then U else U - 1
  (combinations (L - 1) posCount).all (fun pos =>
    wordBad Q L S m0 mod target inv5 D cmin cmax up pos)

def upperAt (b Q L m : Nat) : Bool :=
  let P := L + Q
  let T := tCeil P
  let U := uReq b Q L
  let a : Rat := (8 / 5 : Rat) ^ Q
  let x : Rat := (2 * (5^P : Nat) : Rat) / (2^T : Rat)
  let B : Rat := (if b = 1 then a else 2 * a) * x
  let rho : Rat := (4 / 5 : Rat) ^ U
  let hmax : Rat :=
    1 - (2 / 3 : Rat) * rho - (1 : Rat) / (3 * (if b = 1 then a else 2 * a))
  let Ubr : Rat := if b = 1 then
      2 * a - (2 * a - (89 / 25 : Rat)) / (3 * (m : Rat))
    else
      4 * a - (4 * a - (29 / 5 : Rat)) / (3 * (m : Rat))
  let Rmax : Rat := B * (1 + hmax / (m : Rat))
  decide (Rmax < Ubr)

def lowerOnlyOK : Bool := upperAt 1 20 11 6573

def tablesOK : Bool :=
  allInRange 8 51 (fun Q =>
    allInRange 1 26 (fun L =>
      allInRange 1 3 (fun b =>
        if ! feasible b Q L then true else
          let T := tCeil (L + Q)
          let U := uReq b Q L
          let S := L + U
          let m0 := if S <= 6 then 7 else max 7 ((2^(S-6)) - 1)
          let mod := if b = 1 then 2^(S+4) else 2^(S+6)
          let target := (if b = 1 then 11 else 19) * 2^S
          decide (tableU b Q L = U) &&
          decide (tableS b Q L = S) &&
          decide (tableM0 b Q L = m0) &&
          decide (tableMod b Q L = mod) &&
          decide (tableTarget b Q L = target) &&
          decide (tableD b Q L = 2^T - 5^(L+Q)) &&
          decide ((tableInv5 b Q L * 5^L) % mod = 1) &&
          decide (tableUpper b Q L = upperAt b Q L m0))))

def stageOneScanOK : Bool :=
  tablesOK && lowerOnlyOK && allInRange 8 51 (fun Q =>
    allInRange 1 26 (fun L =>
      allInRange 1 3 (fun b => tripleScan b Q L)))

theorem stageOneScan_check : stageOneScanOK = true := by
  native_decide

#print axioms StringFlow.stageOneScan_check

/-- The stage-one scan certificate applies to every feasible triple
`(b,Q,L)` in the covered ranges. -/
theorem tripleScan_of_stageOneScanOK (b Q L : Nat)
    (hb1 : 1 ≤ b) (hb2 : b ≤ 2)
    (hQ8 : 8 ≤ Q) (hQ50 : Q ≤ 50)
    (hL1 : 1 ≤ L) (hL25 : L ≤ 25) :
    tripleScan b Q L = true := by
  have hcheck := stageOneScan_check
  simp [stageOneScanOK] at hcheck
  rcases hcheck with ⟨⟨_htables, _hlower⟩, htriples⟩
  have hQ51 : Q < 51 := by omega
  have hQrange := allInRange_spec 8 51
    (fun Q => allInRange 1 26 (fun L => allInRange 1 3 (fun b => tripleScan b Q L)))
    htriples Q hQ8 hQ51
  have hL26 : L < 26 := by omega
  have hLrange := allInRange_spec 1 26
    (fun L => allInRange 1 3 (fun b => tripleScan b Q L))
    hQrange L hL1 hL26
  have hb3 : b < 3 := by omega
  exact allInRange_spec 1 3 (fun b => tripleScan b Q L) hLrange b hb1 hb3

#print axioms StringFlow.tripleScan_of_stageOneScanOK

/-- From a per-triple scan certificate, extract the word-level
exclusion for one concrete rising word. -/
theorem wordBad_of_tripleScan (b Q L : Nat) (pos : List Nat)
    (hscan : tripleScan b Q L = true)
    (hmem : pos ∈ combinations (L - 1)
      (if b = 1 then tableU b Q L else tableU b Q L - 1)) :
    wordBad Q L (tableS b Q L) (tableM0 b Q L) (tableMod b Q L)
      (tableTarget b Q L) (tableInv5 b Q L) (tableD b Q L)
      (listMin (chainAVals b Q)) (listMax (chainAVals b Q))
      (tableUpper b Q L) pos = true := by
  unfold tripleScan at hscan
  exact List.all_eq_true.mp hscan pos hmem

/-- The stage-one scan certificate, specialized to one concrete
rising word `pos` in the covered ranges. -/
theorem wordBad_of_stageOneScanOK (b Q L : Nat) (pos : List Nat)
    (hb1 : 1 ≤ b) (hb2 : b ≤ 2)
    (hQ8 : 8 ≤ Q) (hQ50 : Q ≤ 50)
    (hL1 : 1 ≤ L) (hL25 : L ≤ 25)
    (hmem : pos ∈ combinations (L - 1)
      (if b = 1 then tableU b Q L else tableU b Q L - 1)) :
    wordBad Q L (tableS b Q L) (tableM0 b Q L) (tableMod b Q L)
      (tableTarget b Q L) (tableInv5 b Q L) (tableD b Q L)
      (listMin (chainAVals b Q)) (listMax (chainAVals b Q))
      (tableUpper b Q L) pos = true := by
  exact wordBad_of_tripleScan b Q L pos
    (tripleScan_of_stageOneScanOK b Q L hb1 hb2 hQ8 hQ50 hL1 hL25) hmem

#print axioms StringFlow.wordBad_of_stageOneScanOK

end StringFlow
