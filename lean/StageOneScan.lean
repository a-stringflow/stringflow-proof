def combinations : Nat -> Nat -> List (List Nat)
  | _, 0 => [[]]
  | 0, _ + 1 => []
  | n + 1, k + 1 =>
      (combinations n (k + 1)) ++ (combinations n k).map (fun c => n :: c)

def auOfPos (L : Nat) (pos : List Nat) : Nat :=
  ((List.range L).foldl (fun st i =>
    let A := st.1
    let W := st.2
    let t := if pos.contains i then 2 else 1
    (5 * A + 2^W, W + t)) (0, 0)).1

